# Waypoint Logistics Environment Configuration

POSTGRES_USER=waypoint_user
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=waypoint_db
POSTGRES_PORT=5432

# Application Settings
NODE_ENV=production
APP_PORT=3000
JWT_SECRET=change_this_to_a_long_random_secret

# Database & Better Auth
DATABASE_URL=postgresql://waypoint_user:change_this_to_a_strong_password@postgres:5432/waypoint_db
BETTER_AUTH_SECRET=change_this_to_a_long_random_secret
BETTER_AUTH_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com
